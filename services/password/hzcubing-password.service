[Unit]
Description=HZCubing password hashing service
After=network.target

[Service]
Type=simple
DynamicUser=true
WorkingDirectory=/opt/hzcubing-password
EnvironmentFile=/etc/hzcubing-password.env
ExecStart=/usr/bin/node /opt/hzcubing-password/index.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
