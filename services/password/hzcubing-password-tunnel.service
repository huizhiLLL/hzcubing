[Unit]
Description=HZCubing password service Cloudflare Tunnel
After=network-online.target hzcubing-password.service
Wants=network-online.target hzcubing-password.service

[Service]
Type=simple
DynamicUser=true
LoadCredential=tunnel-token:/etc/hzcubing-password-tunnel.token
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 run --token-file %d/tunnel-token
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
