{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hzcubing-next",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [{"binding": "DB", "database_name": "hzcubing-local", "database_id": "00000000-0000-0000-0000-000000000000"}],
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "hzcubing-avatars-local" }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
